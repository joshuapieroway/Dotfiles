// Niri config — mostly stock; see comments for the few non-default bits.
include "config/env.kdl"
include "config/input.kdl"
include "config/output.kdl"
include "config/colors.kdl"
include "config/autostart.kdl"
include "config/keybinds.kdl"
include "animations/glide.kdl"

// Let the wallpaper layer show through the gaps.
layout {
    background-color "transparent"
    border {
        off
    }
    focus-ring {
        off
    }
}

// Rounded window corners.
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// The wallpaper layer is created by Serpantinum; keep it in the gaps.
layer-rule {
    match namespace="^wallpaper-bg$"
    place-within-backdrop true
}
