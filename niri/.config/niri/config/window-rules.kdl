window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

window-rule {
    match app-id="^mpv$"
    open-floating true
}

window-rule {
    match app-id="^imv$"
    open-floating true
}

window-rule {
    match app-id="^org.gnome.Calculator$"
    open-floating true
}

window-rule {
    match app-id="^org.gnome.Nautilus"
    open-floating true
}
