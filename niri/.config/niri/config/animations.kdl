// Material 3 Expressive motion tokens for niri.
//
// Straight transcription of the M3 Expressive motion scheme. No custom tuning,
// no custom shaders.
//
// Expressive is the current recommended M3 scheme (standard is the legacy
// utilitarian one). The two differ in exactly the way that matters:
//
//              standard      expressive
//   spatial    0.9 / 700     0.8 / 380
//   spatial    0.9 / 1400    0.6 / 800    <- fast
//   spatial    0.9 / 300     0.8 / 200    <- slow
//   effects    1.0 / 1600    1.0 / 1600
//   effects    1.0 / 3800    1.0 / 3800
//   effects    1.0 / 800     1.0 / 800
//
// Stiffness drops a lot and damping drops with it, so the expressive springs
// are both slower to resolve and looser in the tail. That is the whole point:
// a lower stiffness means a longer settle, which is where the bounce becomes
// visible rather than being swallowed in the first few frames.
//
// Two token families:
//
//   spatial  position, size, bounds. Overshoots its target and bounces into
//            place. This is where the expressive character lives.
//   effects  opacity, colour. Critically damped at 1.0 in both schemes,
//            deliberately: alpha that swings past 1.0 or dips below 0 before
//            settling reads as a flicker, not as springiness. The split is not
//            a style choice, and animating a fade with a spatial token is the
//            single most common mistake when porting M3 motion.
//
// Easings (the legacy system, still what M3 uses for transitions, and the
// only option niri gives window open/close):
//     emphasized            cubic-bezier(0.2, 0, 0, 1)
//     emphasized decelerate cubic-bezier(0.05, 0.7, 0.1, 1)   enter
//     emphasized accelerate cubic-bezier(0.3, 0, 0.8, 0.15)  exit
//     standard              cubic-bezier(0.2, 0, 0, 1)
//     standard decelerate   cubic-bezier(0, 0, 0, 1)
//     standard accelerate   cubic-bezier(0.3, 0, 1, 1)
//     linear                cubic-bezier(0, 0, 1, 1)
//
// M3 also publishes cubic-bezier approximations of the springs for platforms
// without spring support (expressive default spatial is 0.38, 1.21, 0.22, 1.0
// over 500ms). Those control points overshoot 1.0 on the y axis. They are not
// used here: niri has a real spring solver that carries gesture velocity, and
// it resolves the overshoot properly, so approximating it with a bezier would
// be strictly worse. See the note on the window lifecycle below.
//
// Damping is never pushed above 1.0: niri warns that overdamped springs have
// numerical stability problems and can glitch.

animations {
    // --- Navigation --------------------------------------------------------

    // The most gestural thing on the screen. Default spatial: this one is
    // usually launched by a touchpad flick, and a spring is the only animation
    // type that inherits the release velocity instead of restarting from zero.
    workspace-switch {
        spring damping-ratio=0.8 stiffness=380 epsilon=0.0001
    }

    // --- Window lifecycle ---------------------------------------------------
    //
    // Springs are off the table for both of these. M3 uses spring physics for
    // spatial property changes, but what actually animates on a window open is
    // mostly alpha, and a spatial spring on it would bounce the fade. It is
    // also the one place where niri's spring would misbehave: a spring's
    // progress runs past 1.0, which on an exit means the window briefly swells
    // back outward while being dismissed.
    //
    // Enter and exit still never share a curve. Decelerate on the way in (fast
    // start, gentle landing), accelerate on the way out (slow start, quick
    // departure). Durations are medium2 (300ms) entering and short4 (200ms)
    // exiting: M3 transitions out are consistently faster than in, because an
    // exit is a dismissal and the user is waiting on it.

    window-open {
        duration-ms 300
        curve "cubic-bezier" 0.05 0.7 0.1 1
    }

    window-close {
        duration-ms 200
        curve "cubic-bezier" 0.3 0 0.8 0.15
    }

    // --- Layout ------------------------------------------------------------
    //
    // Identical on purpose. Niri drives these from a single config whenever
    // they have to stay in sync -- a resize that pushes the view off-screen
    // also moves the view -- and mismatched values would visibly tear.
    //
    // Default spatial. The 0.8 damping means these settle with a faint
    // overshoot, which is what makes tiled movement read as material rather
    // than as a slideshow.

    // Camera pan to a window that is off-screen.
    horizontal-view-movement {
        spring damping-ratio=0.8 stiffness=380 epsilon=0.0001
    }

    // Columns sliding over as windows open and close.
    window-movement {
        spring damping-ratio=0.8 stiffness=380 epsilon=0.0001
    }

    // Preset widths, and maximize/unmaximize.
    window-resize {
        spring damping-ratio=0.8 stiffness=380 epsilon=0.0001
    }

    // --- Compositor UI ------------------------------------------------------

    // Config parse error notification: fast spatial. Small element, and at 0.6
    // damping this is the most visibly springy thing in the config -- a real
    // arrival bounce, not a nudge. It is discrete and rare, so it can afford
    // to be the loudest motion here.
    config-notification-open-close {
        spring damping-ratio=0.6 stiffness=800 epsilon=0.001
    }

    // The exit confirmation dialog. A dialog is a mid-sized surface, so
    // default spatial per M3's "partially covers the screen" guidance. Its
    // softness gives it a bit of mass -- a dialog should feel heavier than a
    // toast, since it is asking you to make a decision.
    exit-confirmation-open-close {
        spring damping-ratio=0.8 stiffness=380 epsilon=0.001
    }

    // Screenshot UI: enter easing, short4. A small overlay, and it only fades
    // in -- there is no spatial property changing to justify a spring.
    screenshot-ui-open {
        duration-ms 200
        curve "cubic-bezier" 0.05 0.7 0.1 1
    }

    // The overview is full-screen, which is the one case M3 assigns the slow
    // token. The softness keeps the grid legible while it moves, and it is
    // still a spatial spring at 0.8, so the arrival is soft rather than dead.
    overview-open-close {
        spring damping-ratio=0.8 stiffness=200 epsilon=0.0001
    }

    // Recent windows is a pure alpha fade with no movement to speak of, so it
    // takes an effects token and not a spatial one. Critically damped: no
    // bounce on the alpha.
    recent-windows-close {
        spring damping-ratio=1.0 stiffness=1600 epsilon=0.001
    }
}