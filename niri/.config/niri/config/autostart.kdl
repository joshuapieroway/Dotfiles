spawn-at-startup "zsh" "-c" "wl-paste --type text --watch cliphist store"
spawn-at-startup "zsh" "-c" "wl-paste --type image --watch cliphist store"
spawn-at-startup "systemctl" "--user" "enable" "--now" "easyeffects"
// serpantinumd is started by the serpantinum.service user unit (compositor-agnostic)
spawn-at-startup "xwayland-satellite"
